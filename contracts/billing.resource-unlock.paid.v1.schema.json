{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "data",
    "datacontenttype"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "const": "billing"
    },
    "type": {
      "const": "billing.resource-unlock.paid.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "owner",
        "resource_id",
        "revision"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "subject"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "datacontenttype": {
      "const": "application/json"
    }
  }
}
